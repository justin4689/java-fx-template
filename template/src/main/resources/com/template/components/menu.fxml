<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import com.template.model.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.template.controller.MenuController"
      prefWidth="250" styleClass="app-menu-lateral-container" id="app-menu-lateral-container">

    <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>
    <spacing>10</spacing>

    <!-- Logo centré horizontalement -->
    <HBox alignment="CENTER">
        <ImageView fitWidth="32" fitHeight="32" preserveRatio="true"
                   smooth="true" pickOnBounds="true">
            <image>
                <Image url="@../images/logo.jpg" />
            </image>
        </ImageView>
    </HBox>


        <!-- Bloc avatar + nom/prénom utilisateur -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="user-info">
            <!-- Remplace l'URL par le chemin réel de ton image d'avatar -->
            <ImageView fitWidth="32" fitHeight="32" preserveRatio="true"
                       smooth="true" pickOnBounds="true">
                <image>
                    <Image url="@../images/avatar.png" />
                </image>
            </ImageView>
            <VBox>
                <Label text="John Doe" styleClass="user-name"/>
                <Label text="Administrateur" styleClass="user-role"/>
            </VBox>
        </HBox>
    <Label text="MENU DE NAVIGATION" styleClass="menu-title"/>


    <Button fx:id="btnDashboard" id="btnDashboard" text="Tableau de bord" onAction="#loadDashboard" styleClass="menu-btn">
        <graphic>
            <FontIcon iconLiteral="mdi2v-view-dashboard" iconSize="18" />
        </graphic>
    </Button>
    <Button fx:id="btnClients" id="btnClients" text="Clients" onAction="#loadClients" styleClass="menu-btn">
        <graphic>
            <FontIcon iconLiteral="mdi2a-account-group" iconSize="18" />
        </graphic>
    </Button>
    <Button fx:id="btnUserManagement" id="btnUserManagement" text="Gestion des utilisateurs" onAction="#loadUserManagement" styleClass="menu-btn">
        <graphic>
            <FontIcon iconLiteral="mdi2a-account-cog" iconSize="18" />
        </graphic>
    </Button>
    <VBox spacing="0">
        <Button fx:id="btnSettings" id="btnSettings" onAction="#toggleSettingsSubmenu"
                styleClass="menu-btn" contentDisplay="GRAPHIC_ONLY">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="mdi2c-cog" iconSize="18" />
                    <Label text="Paramètres" />
                    <Region HBox.hgrow="ALWAYS" />
                    <FontIcon fx:id="settingsChevronIcon" iconLiteral="mdi2c-chevron-right" iconSize="16" />
                </HBox>
            </graphic>
        </Button>

        <!-- Sous-menu Paramètre -->
        <VBox fx:id="settingsSubmenu" styleClass="submenu" visible="false" managed="false">
            <Button fx:id="btnSettingsGeneral"   text="Général"   onAction="#loadSettings" styleClass="submenu-btn"/>
            <Button fx:id="btnSettingsSecurity"  text="Sécurité"  onAction="#loadSettings" styleClass="submenu-btn"/>
            <Button fx:id="btnSettingsAppearance" text="Apparence" onAction="#loadSettings" styleClass="submenu-btn"/>
        </VBox>
    </VBox>

    <!-- Espaceur -->
    <VBox VBox.vgrow="ALWAYS"/>
    <Button fx:id="btnLogout" text="🚪 Déconnexion" onAction="#handleLogout" styleClass="menu-btn-logout"/>
</VBox>

